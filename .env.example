# ─────────────────────────────────────────────────────────────────────────────
# ConsultAI Platform  –  Environment Variables
# Copy to .env and fill in your API keys
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (database & auth)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ── AI Keys (also configurable in Settings → AI Configuration) ──────────────
# Anthropic Claude  →  https://console.anthropic.com/
VITE_ANTHROPIC_KEY=""

# Perplexity AI (web search)  →  https://www.perplexity.ai/settings/api
VITE_PERPLEXITY_KEY=""

# Tavily Search (web search)  →  https://tavily.com/
VITE_TAVILY_KEY=""

# OpenAI GPT-4o (vision/fallback)  →  https://platform.openai.com/api-keys
VITE_OPENAI_KEY=""

# SerpAPI (Google Search)  →  https://serpapi.com/manage-api-key
VITE_SERPAPI_KEY=""

# Firecrawl (web scraping)  →  https://www.firecrawl.dev/app/api-keys
VITE_FIRECRAWL_KEY=""
